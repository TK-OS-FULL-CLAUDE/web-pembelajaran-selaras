# Salin file ini menjadi .env.local (lokal) atau isi di Vercel → Settings → Environment Variables.
# Jangan pernah commit file .env.local atau kunci asli. Hanya file contoh ini yang boleh masuk Git.

# WAJIB — koneksi Postgres. Supabase: tombol "Connect" → "Transaction pooler" (port 6543).
# Ganti [YOUR-PASSWORD] dengan kata sandi database. Jangan pakai "Direct connection" (port 5432, IPv6)
# karena Vercel tidak bisa menjangkaunya.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# DISARANKAN — rahasia untuk menandatangani cookie login. Isi string acak panjang,
# misalnya hasil: openssl rand -base64 32
SESSION_SECRET=

# OPSIONAL — fitur AI memakai Claude API (foto buku → teks, draf versi mudah & bahasa daerah, draf kuis).
# Buat kunci di https://console.anthropic.com → API Keys. Berbayar per pemakaian; akun baru biasanya
# mendapat sedikit kredit percobaan. Tanpa kunci ini, app tetap jalan penuh tanpa tombol AI.
ANTHROPIC_API_KEY=

# OPSIONAL — paksa satu model tertentu. Kosongkan untuk urutan default:
# claude-haiku-5-5 (murah & cepat) lalu claude-sonnet-5-5 sebagai cadangan.
ANTHROPIC_MODEL=
