# Salin file ini menjadi .env.local (lokal) atau isi di Vercel → Settings → Environment Variables.
# Jangan pernah commit file .env.local atau kunci asli. Hanya file contoh ini yang boleh masuk Git.

# WAJIB — koneksi Postgres. Supabase: tombol "Connect" → "Transaction pooler" (port 6543).
# Ganti [YOUR-PASSWORD] dengan kata sandi database. Jangan pakai "Direct connection" (port 5432, IPv6)
# karena Vercel tidak bisa menjangkaunya.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# DISARANKAN — rahasia untuk menandatangani cookie login. Isi string acak panjang,
# misalnya hasil: openssl rand -base64 32
SESSION_SECRET=

# OPSIONAL — fitur AI (foto buku → teks, draf teks mudah, ringkasan, Basa Jawa, Basa Sunda, draf kuis).
# Isi salah satu atau keduanya. Bila keduanya diisi, yang satu menjadi cadangan saat yang lain gagal
# (kunci ditolak, kredit/kuota habis, sibuk). Tanpa kunci, app tetap jalan penuh tanpa tombol AI.
#   Foto → teks dan draf kuis: Gemini dulu, cadangan Claude.
#   Versi teks (mudah, ringkasan, Basa Jawa, Basa Sunda): Claude dulu, cadangan Gemini.

# Claude: buat kunci di https://console.anthropic.com → API Keys. Berbayar per pemakaian.
ANTHROPIC_API_KEY=

# OPSIONAL — paksa satu model Claude. Kosongkan untuk urutan default:
# claude-haiku-5-5 (murah & cepat) lalu claude-sonnet-5-5 sebagai cadangan.
ANTHROPIC_MODEL=

# Gemini: buat kunci di https://aistudio.google.com → Get API key. Ada kuota gratis.
GEMINI_API_KEY=

# OPSIONAL — paksa satu model Gemini. Kosongkan untuk urutan default:
# gemini-3.6-flash lalu gemini-3.5-flash-lite sebagai cadangan.
GEMINI_MODEL=

# OPSIONAL — batas permintaan AI per akun guru per jam (default 100), supaya kredit tidak habis
# bila akun demo dipakai bersama saat penjurian.
AI_LIMIT_PER_HOUR=
